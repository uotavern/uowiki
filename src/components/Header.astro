---
// Override of Starlight's Header: prepend the shared cross-site "global bar"
// above the default wiki header, so the wiki reads as part of one UO Tavern
// site. The bar's MENU is defined once, in uohub/uo-nav.json; uo-nav.ts loads
// it and renders it the way uohub/tools/uo_nav.py does (brand, one <a> per
// item, the shared inline theme toggle), marking only the "wiki" item active.
// The markup contract and styling are the shared ones from uo-design.css
// (.uo-globalbar*) — no per-site CSS here. See DESIGN.md ("The global bar").
import Default from '@astrojs/starlight/components/Header.astro';
import { loadNav, renderGlobalbar } from './uo-nav';

const bar = renderGlobalbar(await loadNav(), 'wiki');
---

<Fragment set:html={bar} />

<Default><slot /></Default>

<script>
  import './wiki-search-query';
</script>
